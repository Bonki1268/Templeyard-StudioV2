{
  "name": "@templeyard/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:import": "tsx src/scripts/import-temples.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@templeyard/comfy-client": "workspace:^",
    "@templeyard/prompts": "workspace:^",
    "@templeyard/shared": "workspace:^",
    "better-sqlite3": "12.11.1",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
