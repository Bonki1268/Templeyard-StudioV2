{
  "version": 1,
  "note": "各模型的 Comfy Cloud MCP 呼叫設定（docs/02-TRD.md「各模型的呼叫方式」、docs/07-實測紀錄.md）。status：verified 已實測、unverified 有代號但還沒實測、unknown 呼叫方式還沒確認。price.credits 為 null 表示參考單價待實測。slots 的 path 是寫進 MCP 呼叫參數的位置；沒有 path 的 slot 只用在 template。 2026-11-03 實測：上傳用 upload_file 的一次性網址；Nano Banana Pro 的參考圖放在 medias、一次 1 張（多的拼成一張）；Gemini 用圖生影片範本（首格在第 11 號節點），有末格或關鍵畫格時改用參考圖範本；Seedance 2.0 用首尾畫格範本。",
  "upload": {
    "mode": "signed_put",
    "tool": "upload_file",
    "clientOs": "darwin"
  },
  "models": {
    "gemini-omni-1.1-flash": {
      "label": "Gemini Omni 1.1 Flash",
      "kind": "video",
      "status": "verified",
      "tool": "run_template",
      "args": {
        "name": "api_google_gemini_omni_flash_1_1_i2v",
        "input_overrides": {
          "7": {
            "model.resolution": "720p",
            "model.task_type": "image_to_video"
          }
        }
      },
      "slots": {
        "prompt": {
          "paths": [
            [
              "input_overrides",
              "7",
              "model.prompt"
            ]
          ],
          "template": "A {{durationSec}}-second, {{aspectRatio}} clip. Use @Image1 as the first frame. {{prompt}}"
        },
        "aspectRatio": {
          "paths": [
            [
              "input_overrides",
              "7",
              "model.aspect_ratio"
            ]
          ],
          "allowed": [
            "16:9",
            "9:16"
          ]
        },
        "durationSec": {
          "paths": [],
          "min": 3,
          "max": 10
        },
        "seed": {
          "paths": [
            [
              "input_overrides",
              "7",
              "model.seed"
            ]
          ]
        }
      },
      "price": {
        "unit": "second",
        "credits": 31,
        "verified": true
      },
      "frameInputs": {
        "first": {
          "paths": [
            [
              "input_overrides",
              "11",
              "image"
            ]
          ]
        }
      },
      "referenceVariant": {
