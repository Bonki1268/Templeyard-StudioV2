            "7": {
              "model.resolution": "720p",
              "model.task_type": "reference_to_video"
            }
          }
        },
        "slots": {
          "prompt": {
            "paths": [
              [
                "input_overrides",
                "7",
                "model.prompt"
              ]
            ],
            "template": "[# References <IMAGE_REF_0>@Image1 <IMAGE_REF_1>@Image2]\nA {{durationSec}}-second, {{aspectRatio}} clip. @Image1 is the first frame; @Image2 is a reference sheet. {{prompt}}"
          },
          "aspectRatio": {
            "paths": [
              [
                "input_overrides",
                "7",
                "model.aspect_ratio"
              ]
            ],
            "allowed": [
              "16:9",
              "9:16"
            ]
          },
          "durationSec": {
            "paths": [],
            "min": 3,
            "max": 10
          },
          "seed": {
            "paths": [
              [
                "input_overrides",
                "7",
                "model.seed"
              ]
            ]
          }
        },
        "frameInputs": {
          "first": {
            "paths": [
              [
                "input_overrides",
                "11",
                "image"
              ]
            ]
          }
        },
        "references": {
          "paths": [
            [
              "input_overrides",
              "15",
              "image"
            ]
          ],
          "max": 1,
          "format": "single",
          "sheet": {
            "max": 4
          }
        }
      }
    },
